# LLM（大语言模型）接入配置模板 —— 复制为 .env 后填入自己的值。
#   cp .env.example .env
# .env 已被 .gitignore 忽略；本模板是唯一进版本库的示例文件。

# 提供方标识，仅作标记用，协议统一为 OpenAI 兼容：knot / deepseek / openai / ollama
LLM_PROVIDER=knot

# OpenAI 兼容地址，不含 /chat/completions（客户端自动拼接）
#   knot     : 见 knot 平台「API 接入」页面给出的网关地址
#   deepseek : https://api.deepseek.com/v1
#   openai   : https://api.openai.com/v1
#   ollama   : http://localhost:11434/v1
LLM_BASE_URL=https://knot.woa.com/v1

# 密钥（knot 平台个人 token / 各家 API Key）
LLM_API_KEY=

# 模型名
LLM_MODEL=gpt-4o-mini

# 单次请求超时（秒）
LLM_TIMEOUT=60

# 采样温度：生成测试用例这类需要稳定输出的场景建议 0.0–0.3
LLM_TEMPERATURE=0.2

# 网络/5xx 重试次数
LLM_MAX_RETRIES=2
